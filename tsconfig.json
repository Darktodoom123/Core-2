{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "typeRoots": ["./node_modules/@types"],
        "paths": {
            "@/*": ["./apps/operations/resources/js/*"]
        },
        "jsx": "react-jsx"
    },
    "include": [
        "apps/operations/resources/js/**/*.ts",
        "apps/operations/resources/js/**/*.d.ts",
        "apps/operations/resources/js/**/*.tsx",
        "apps/operations/tests/React/**/*.ts",
        "apps/operations/tests/React/**/*.tsx"
    ]
}
