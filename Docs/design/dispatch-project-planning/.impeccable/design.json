    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Status color accompanies readable operational state or a labeled timeline legend.",
        "section": "colors"
      },
      {
        "name": "The Decision First Rule",
        "body": "Use size and weight to distinguish the phase, required counts, and action; supporting dates and references remain subordinate.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do retain the incumbent workspace typography, semantic colors, and shared controls.",
      "Do align timeline labels, grid lines, and bars to the same timestamps.",
