// Conceptual operational ERD. Laravel migrations and Eloquent models remain
// authoritative. Infrastructure and Spatie RBAC tables are intentionally
// omitted; see Docs/database.md for the complete table catalog.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          BigInt      @id @default(autoincrement())
  name        String
  username    String      @unique
  email       String
  emailVerifiedAt DateTime?
  password    String
  phone       String?
  isActive    Boolean     @default(true)
  suspendedAt DateTime?
  rememberToken String?
  createdAt   DateTime?
  updatedAt   DateTime?
  serviceRequests ServiceRequest[]
  personnelProfile PersonnelProfile?
  personnelCredentials PersonnelCredential[]
  dispatchJobs DispatchJob[]
  dispatchPersonnelAssignments DispatchPersonnelAssignment[]
  dispatchAssetAssignments DispatchAssetAssignment[]
  inspections Inspection[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  fuelRequests FuelRequest[]
  fuelLogs FuelLog[]
  locationUpdates LocationUpdate[]
  jobReports JobReport[]
  approvalRequests ApprovalRequest[]
  auditEvents AuditEvent[]
  gptRecommendations GptRecommendation[]
  attachments Attachment[]
  commandLogs CommandLog[]
}

model Client {
  id          BigInt      @id @default(autoincrement())
  code        String
  companyName String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  status      String      @default("active")
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  serviceRequests ServiceRequest[]
}

model ServiceRequest {
  id          BigInt      @id @default(autoincrement())
  reference   String
  clientId    BigInt
  createdBy   BigInt
  projectName String
  serviceType String
  location    String
  siteNotes   String?
  scheduledDate DateTime?
  priority    String      @default("routine")
  status      String      @default("submitted")
  requirements Json?
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchJobs DispatchJob[]
}

model PersonnelProfile {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt
  employeeNumber String?
  availabilityStatus String @default("available")
  emergencyContactName String?
  emergencyContactPhone String?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model PersonnelCredential {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt
  kind        String
  credentialNumber String
  credentialType String
  issuedAt    DateTime?
  expiresAt   DateTime?
  status      String      @default("active")
  verifiedBy  BigInt?
  verifiedAt  DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model OperationalAsset {
  id          BigInt      @id @default(autoincrement())
  code        String
  name        String
  kind        String
  subtype     String?
  status      String
  location    String?
  specifications Json?
  registrationNumber String?
  manufacturer String?
  model       String?
  ratedCapacity Decimal?
  capacityUnit String?
  meterType   String?
  meterValue  Decimal?
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchAssetAssignments DispatchAssetAssignment[]
  inspections Inspection[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  fuelRequests FuelRequest[]
  locationUpdates LocationUpdate[]
}

model DispatchJob {
  id          BigInt      @id @default(autoincrement())
  serviceRequestId BigInt?
  reference   String
  client      String
  title       String
  site        String
  siteNotes   String?
  scheduledStart DateTime?
  scheduledEnd DateTime?
  priority    String
  status      String
  requirements Json?
  createdBy   BigInt
  activatedBy BigInt?
  cancelledBy BigInt?
  cancellationReason String?
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchPersonnelAssignments DispatchPersonnelAssignment[]
  dispatchAssetAssignments DispatchAssetAssignment[]
  fuelRequests FuelRequest[]
  locationUpdates LocationUpdate[]
  jobReports JobReport[]
  notifications Notification[]
}

model DispatchPersonnelAssignment {
  id          BigInt      @id @default(autoincrement())
  dispatchJobId BigInt
  userId      BigInt
  assignmentType String
  responseStatus String @default("pending")
  respondedAt DateTime?
  responseReason String?
  assignedBy  BigInt
  approvedBy  BigInt?
  activeFrom  DateTime?
  activeUntil DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model DispatchAssetAssignment {
  id          BigInt      @id @default(autoincrement())
  dispatchJobId BigInt
  operationalAssetId BigInt
  assignmentType String
  assignedBy  BigInt
  approvedBy  BigInt?
  activeFrom  DateTime?
  activeUntil DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model Inspection {
  id          BigInt      @id @default(autoincrement())
  operationalAssetId BigInt
  technicianId BigInt
  type        String
  result      String
  checklist   Json
  findings    String?
  completedAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model MaintenanceWorkOrder {
  id          BigInt      @id @default(autoincrement())
  operationalAssetId BigInt
  technicianId BigInt?
  status      String
  defect      String
  workPerformed Json?
  parts       Json?
  dispatchBlocking Boolean @default(true)
  scheduledAt DateTime?
  releasedAt  DateTime?
  releaseVerifiedBy BigInt?
  releaseChecklist Json?
  nextDueAt   DateTime?
  remarks     String?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model FuelRequest {
  id          BigInt      @id @default(autoincrement())
  reference   String
  requesterId BigInt
  dispatchJobId BigInt?
  operationalAssetId BigInt?
  quantityLitres Decimal
  fuelType    String
  purpose     String
  status      String      @default("submitted")
  reviewedBy  BigInt?
  approvedBy  BigInt?
  verifiedBy  BigInt?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  verifiedAt  DateTime?
  decisionReason String?
  createdAt   DateTime?
  updatedAt   DateTime?
  fuelLogs FuelLog[]
}

model FuelLog {
  id          BigInt      @id @default(autoincrement())
  fuelRequestId BigInt
  recordedBy  BigInt
  quantityLitres Decimal
  odometerKm  BigInt?
  hourMeter   Decimal?
  pricePerLitre Decimal?
  totalCost   Decimal?
  fuelStation String?
  receiptPath String?
  remarks     String?
  recordedAt  DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
}

model LocationUpdate {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt
  operationalAssetId BigInt?
  dispatchJobId BigInt?
  latitude    Decimal
  longitude   Decimal
  accuracyMetres Decimal?
  speed       Decimal?
  source      String      @default("mobile")
  sharingEnabled Boolean @default(true)
  remarks     String?
  capturedAt  DateTime
  receivedAt  DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
}

model JobReport {
  id          BigInt      @id @default(autoincrement())
  dispatchJobId BigInt
  authorId    BigInt
  startedAt   DateTime?
  endedAt     DateTime?
  workSummary String
  remarks     String?
  status      String      @default("draft")
  submittedAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model ApprovalRequest {
  id          BigInt      @id @default(autoincrement())
  subjectType String
  subjectId   BigInt
  kind        String
  requestedChanges Json?
  status      String      @default("pending")
  requestedBy BigInt
  decidedBy   BigInt?
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  // subjectType + subjectId is a polymorphic subject reference.
}

model AuditEvent {
  id          BigInt      @id @default(autoincrement())
  actorId     BigInt?
  subjectType String?
  subjectId   BigInt?
  action      String
  before      Json?
  after       Json?
  reason      String?
  requestId   String?
  ipAddress   String?
  occurredAt  DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
}

model GptRecommendation {
  id          BigInt      @id @default(autoincrement())
  subjectType String?
  subjectId   BigInt?
  requestedBy BigInt
  decidedBy   BigInt?
  purpose     String
  contextHash String
  inputReferences Json
  recommendation Json
  conflicts   Json?
  model       String
  status      String      @default("draft")
  usage       Json?
  decidedAt   DateTime?
  promptSummary String?
  responseSummary String?
  costUsd Decimal?
  errorMessage String?
  expiresAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  // subjectType + subjectId is a polymorphic subject reference.
}

model Attachment {
  id          BigInt      @id @default(autoincrement())
  ownerType   String
  ownerId     BigInt
  uploadedBy  BigInt
  kind        String      @default("document")
  disk        String      @default("local")
  path        String
  originalFilename String
  mimeType    String
  sizeBytes   BigInt
  checksumSha256 String
  retentionUntil DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  // ownerType + ownerId is a polymorphic owner reference.
}

model Notification {
  id          String      @id @default(uuid())
  type        String
  notifiableType String
  notifiableId BigInt
  dispatchJobId BigInt?
  status      String      @default("unread")
  data        String
  readAt      DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  // notifiableType + notifiableId is Laravel's polymorphic recipient.
}

model CommandLog {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt
  commandId   String
  actionName  String
  payloadHash String?
  expectedVersion Int?
  status      String      @default("completed")
  responseCode Int        @default(200)
  responsePayload Json?
  createdAt   DateTime?
  updatedAt   DateTime?
}

// Rental and Sales are implemented partial backend/API slices. These entities
// are conceptual and intentionally mirror the Laravel model/table boundary;
// they do not add the deferred Core 1 receiving contract, UI, delivery,
// accounting, payment, or invoicing surfaces.

model RentalReservation {
  id              BigInt      @id @default(autoincrement())
  reference       String      @unique
  clientId        BigInt
  createdBy       BigInt
  approvedBy      BigInt?
  dispatchJobId   BigInt?
  status          String      @default("requested")
  startDate       DateTime
  endDate         DateTime
  deliveryLocation String?
  fulfillmentMode String      @default("delivery")
  notes           String?
  totalCents      Int         @default(0)
  deletedAt       DateTime?
  createdAt       DateTime?
  updatedAt       DateTime?
  client          Client
  creator         User
  items           RentalReservationItem[]
  operatorAssignments RentalOperatorAssignment[]
  checkout        RentalCheckout?
  returnRecord    RentalReturnRecord?
  // dispatchJobId is a nullable operational handoff placeholder.
  @@index([clientId, status])
  @@index([status, startDate, endDate])
  @@map("rental_reservations")
}

model RentalReservationItem {
  id                  BigInt      @id @default(autoincrement())
  rentalReservationId BigInt
  operationalAssetId  BigInt
  quantity            Int         @default(1)
  rateCents           Int
  lineTotalCents      Int
  createdAt           DateTime?
  updatedAt           DateTime?
  reservation         RentalReservation
  asset               OperationalAsset
  operatorAssignments RentalOperatorAssignment[]
  @@index([operationalAssetId, rentalReservationId])
  @@map("rental_reservation_items")
}

model RentalOperatorAssignment {
  id                    BigInt      @id @default(autoincrement())
  rentalReservationId   BigInt
  rentalReservationItemId BigInt
  userId                BigInt
  operatorType          String
  assignedBy            BigInt
  activeFrom            DateTime
  activeUntil           DateTime
  createdAt             DateTime?
  updatedAt             DateTime?
  reservation            RentalReservation
  item                  RentalReservationItem
  operator              User
  assigner              User
  @@unique([rentalReservationItemId, userId])
  @@index([userId, activeFrom, activeUntil])
  @@map("rental_operator_assignments")
}

model RentalCheckout {
  id                  BigInt      @id @default(autoincrement())
  rentalReservationId BigInt      @unique
  checkedOutBy        BigInt
  checkedOutAt        DateTime
  conditionBefore     Json?
  notes               String?
  createdAt           DateTime?
  updatedAt           DateTime?
  reservation         RentalReservation
  actor               User
  @@map("rental_checkouts")
}

model RentalReturnRecord {
  id                  BigInt      @id @default(autoincrement())
  rentalReservationId BigInt      @unique
  returnedBy          BigInt
  returnedAt          DateTime
  conditionAfter      Json?
  damageNotes         String?
  createdAt           DateTime?
  updatedAt           DateTime?
  reservation         RentalReservation
  actor               User
  @@map("rental_returns")
}

model SalesCatalogItem {
  id                  BigInt      @id @default(autoincrement())
  sku                 String      @unique
  name                String
  description         String?
  unitPriceCents      Int
  quantityOnHand      Int         @default(0)
  quantityReserved    Int         @default(0)
  operationalAssetId  BigInt?     @unique
  status              String      @default("active")
  createdAt           DateTime?
  updatedAt           DateTime?
  asset               OperationalAsset?
  quoteItems          SalesQuoteItem[]
  orderItems         SalesOrderItem[]
  inventoryLedger     SalesInventoryLedger[]
  ownershipTransfers  OwnershipTransfer[]
  @@index([status, quantityOnHand])
  @@map("sales_catalog_items")
}

model SalesQuote {
  id          BigInt      @id @default(autoincrement())
  reference   String      @unique
  clientId    BigInt
  createdBy   BigInt
  status      String      @default("draft")
  currency    String      @default("PHP")
  totalCents  Int         @default(0)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime?
  updatedAt   DateTime?
  client      Client
  creator     User
  items       SalesQuoteItem[]
  order       SalesOrder?
  @@map("sales_quotes")
}

model SalesQuoteItem {
  id                 BigInt      @id @default(autoincrement())
  salesQuoteId       BigInt
  salesCatalogItemId BigInt
  quantity           Int
  unitPriceCents     Int
  lineTotalCents     Int
  createdAt          DateTime?
  updatedAt          DateTime?
  quote              SalesQuote
  catalogItem        SalesCatalogItem
  @@map("sales_quote_items")
}

model SalesOrder {
  id          BigInt      @id @default(autoincrement())
  reference   String      @unique
  clientId    BigInt
  salesQuoteId BigInt?
  createdBy   BigInt
  status      String      @default("confirmed")
  currency    String      @default("PHP")
  totalCents  Int         @default(0)
  fulfilledAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  client      Client
  quote       SalesQuote?
  creator     User
  items       SalesOrderItem[]
  transfers   OwnershipTransfer[]
  @@map("sales_orders")
}

model SalesOrderItem {
  id                 BigInt      @id @default(autoincrement())
  salesOrderId       BigInt
  salesCatalogItemId BigInt
  quantity           Int
  unitPriceCents     Int
  lineTotalCents     Int
  createdAt          DateTime?
  updatedAt          DateTime?
  order              SalesOrder
  catalogItem        SalesCatalogItem
  ownershipTransfer  OwnershipTransfer?
  @@index([salesCatalogItemId, salesOrderId])
  @@map("sales_order_items")
}

model SalesInventoryLedger {
  id                 BigInt      @id @default(autoincrement())
  salesCatalogItemId BigInt
  salesOrderId       BigInt?
  createdBy          BigInt
  entryType          String
  quantityDelta      Int
  metadata           Json?
  createdAt          DateTime?
  updatedAt          DateTime?
  catalogItem        SalesCatalogItem
  order              SalesOrder?
  creator            User
  @@index([salesCatalogItemId, entryType])
  @@map("sales_inventory_ledger")
}

model OwnershipTransfer {
  id                 BigInt      @id @default(autoincrement())
  salesOrderId       BigInt
  salesOrderItemId   BigInt
  salesCatalogItemId BigInt
  operationalAssetId BigInt?
  transferredBy      BigInt
  transferredAt      DateTime
  createdAt          DateTime?
  updatedAt          DateTime?
  order              SalesOrder
  orderItem          SalesOrderItem
  catalogItem        SalesCatalogItem
  asset              OperationalAsset?
  actor              User
  @@unique([salesOrderItemId, salesCatalogItemId])
  @@unique([operationalAssetId])
  @@map("ownership_transfers")
}
