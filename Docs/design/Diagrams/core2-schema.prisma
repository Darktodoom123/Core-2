}

model FuelLog {
  id          BigInt      @id @default(autoincrement()
  recordedBy  Int
  odometerKm  Int?
  hourMeter   Decimal?
  receiptPath String?
  recordedAt  DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
  totalCost   Decimal?
  fuelStation String?
  remarks     String?
  user User @relation(fields: [recordedBy], references: [id])
  fuelRequest FuelRequest @relation(fields: [fuelRequestId], references: [id])
}

model FuelRequest {
  id          BigInt      @id @default(autoincrement()
  reference   String
  requesterId BigInt
  fuelType    String
  purpose     String
  status      String      @default("submitted")
  reviewedBy  Int?
  approvedBy  Int?
  verifiedBy  Int?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
