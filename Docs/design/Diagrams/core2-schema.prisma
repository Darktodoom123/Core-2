  updatedAt   DateTime?
  ownershipTransfers OwnershipTransfer[]
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model SalesOrder {
  id          BigInt      @id @default(autoincrement()
  reference   String
  clientId    BigInt
  createdBy   Int
  status      String      @default("confirmed")
  currency    String      @default("PHP")
  totalCents  Int         @default("0")
  fulfilledAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  ownershipTransfers OwnershipTransfer[]
  salesInventoryLedgers SalesInventoryLedger[]
  salesOrderItems SalesOrderItem[]
  user User @relation(fields: [createdBy], references: [id])
  salesQuote SalesQuote @relation(fields: [salesQuoteId], references: [id])
}

model SalesQuoteItem {
  id          BigInt      @id @default(autoincrement()
  quantity    Int
  createdAt   DateTime?
  updatedAt   DateTime?
  salesQuote SalesQuote @relation(fields: [salesQuoteId], references: [id])
}

model SalesQuote {
  id          BigInt      @id @default(autoincrement()
  reference   String
  clientId    BigInt
  createdBy   Int
  status      String      @default("draft")
  currency    String      @default("PHP")
  totalCents  Int         @default("0")
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime?
  updatedAt   DateTime?
  salesOrders SalesOrder[]
  salesQuoteItems SalesQuoteItem[]
  user User @relation(fields: [createdBy], references: [id])
}

model ServiceRequest {
  id          BigInt      @id @default(autoincrement()
  reference   String
  clientId    BigInt
  createdBy   Int
  projectName String
  serviceType String
  location    String
  siteNotes   String?
  priority    String      @default("routine")
  status      String      @default("submitted")
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchJobs DispatchJob[]
  user User @relation(fields: [createdBy], references: [id])
}

model Session {
  id          String      @id
  userId      BigInt?
  ipAddress   String?
  userAgent   String?
  payload     String
}

model User {
  id          BigInt      @id @default(autoincrement()
  name        String
  email       String
  password    String
  createdAt   DateTime?
  updatedAt   DateTime?
  isActive    Boolean     @default(true)
  suspendedAt DateTime?
  phone       String?
  username    String
  approvalRequests ApprovalRequest[]
  attachments Attachment[]
  auditEvents AuditEvent[]
  commandLogs CommandLog[]
  dispatchAssetAssignments DispatchAssetAssignment[]
  dispatchAssignmentOffers DispatchAssignmentOffer[]
  dispatchEmergencyOverrides DispatchEmergencyOverride[]
  dispatchExecutionAttempts DispatchExecutionAttempt[]
  dispatchHandoffs DispatchHandoff[]
  dispatchJobs DispatchJob[]
  dispatchPersonnelAssignments DispatchPersonnelAssignment[]
  dispatchPlanApprovals DispatchPlanApproval[]
  dispatchPlanRequirementSlots DispatchPlanRequirementSlot[]
  dispatchPlanVersions DispatchPlanVersion[]
  fuelLogs FuelLog[]
  fuelRequests FuelRequest[]
  gptRecommendations GptRecommendation[]
  inspections Inspection[]
  jobReports JobReport[]
  locationUpdates LocationUpdate[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  ownershipTransfers OwnershipTransfer[]
  personnelCredentials PersonnelCredential[]
  personnelProfile PersonnelProfile
  rentalCheckouts RentalCheckout[]
  rentalOperatorAssignments RentalOperatorAssignment[]
  rentalReservations RentalReservation[]
  rentalReturns RentalReturn[]
  reportExports ReportExport[]
  salesInventoryLedgers SalesInventoryLedger[]
  salesOrders SalesOrder[]
  salesQuotes SalesQuote[]
  serviceRequests ServiceRequest[]
}
