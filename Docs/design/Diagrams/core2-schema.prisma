  user User @relation(fields: [verifiedBy], references: [id])
  operationalAsset OperationalAsset @relation(fields: [operationalAssetId], references: [id])
}

model GptRecommendationMetric {
  id          BigInt      @id @default(autoincrement()
  event       String
  status      String?
  latencyMs   Int?
  totalTokens Int?
  costUsd     Decimal?
  occurredAt  DateTime
  purgeAt     DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
  gptRecommendation GptRecommendation @relation(fields: [recommendationId], references: [id])
}

model GptRecommendation {
  id          BigInt      @id @default(autoincrement()
  subjectType String?
  subjectId   BigInt?
  requestedBy Int
  purpose     String
  contextHash String
  conflicts   Json?
  model       String
  status      String      @default("draft")
  decidedBy   Int?
  decidedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  usage       Json?
  expiresAt   DateTime?
  costUsd     Decimal?
  generatedAt DateTime?
  latencyMs   Int?
  purgeAt     DateTime?
  retryOfId   BigInt?
  gptRecommendationMetrics GptRecommendationMetric[]
  gptRecommendation GptRecommendation @relation(fields: [retryOfId], references: [id])
