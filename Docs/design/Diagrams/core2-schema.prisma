}

model DispatchReconciliationFinding {
  id          BigInt      @id @default(autoincrement()
  runId       BigInt?
  entityType  String
  entityId    BigInt?
  code        String
  severity    String      @default("blocker")
  details     Json?
  fingerprint String
  resolvedAt  DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
