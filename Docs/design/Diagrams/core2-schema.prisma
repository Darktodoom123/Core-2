}

model DispatchReconciliationRun {
  id          BigInt      @id @default(autoincrement()
  name        String      @default("dispatch_v2_foundation")
  status      String      @default("running")
  dryRun      Boolean     @default(false)
  batchLimit  Int         @default("100")
  checkpoint  Json?
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime?
  updatedAt   DateTime?
