}

model DispatchPlanApproval {
  id          BigInt      @id @default(autoincrement()
  kind        String
  status      String      @default("pending")
  requestedBy Int?
  decidedBy   Int?
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [decidedBy], references: [id])
  dispatchPlanVersion DispatchPlanVersion @relation(fields: [planVersionId], references: [id])
}

model DispatchPlanRequirementSlot {
  id          BigInt      @id @default(autoincrement()
  attemptId   BigInt
  kind        String
  slotKey     String
  isMandatory Boolean     @default(false)
  userId      BigInt?
  createdBy   Int?
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [createdBy], references: [id])
  operationalAsset OperationalAsset @relation(fields: [operationalAssetId], references: [id])
  dispatchPlanVersion DispatchPlanVersion @relation(fields: [planVersionId], references: [id])
}

model DispatchPlanVersion {
  id          BigInt      @id @default(autoincrement()
  attemptId   BigInt
  version     Int
  status      String      @default("draft")
  snapshot    Json
  contentHash String
  createdBy   Int?
  submittedBy Int?
  submittedAt DateTime?
  sealedAt    DateTime?
  createdAt   DateTime    @default(now()
  dispatchAssignmentOffers DispatchAssignmentOffer[]
  dispatchAuditLineages DispatchAuditLineage[]
  dispatchEmergencyOverrides DispatchEmergencyOverride[]
  dispatchPlanApprovals DispatchPlanApproval[]
  dispatchPlanRequirementSlots DispatchPlanRequirementSlot[]
