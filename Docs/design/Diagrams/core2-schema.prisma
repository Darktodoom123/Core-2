  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [technicianId], references: [id])
  operationalAsset OperationalAsset @relation(fields: [operationalAssetId], references: [id])
}

model JobBatche {
  id          String      @id
  name        String
  totalJobs   Int
