datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApprovalRequest {
  id          BigInt      @id @default(autoincrement()
  subjectType String
  subjectId   BigInt
  kind        String
  status      String      @default("pending")
  requestedBy Int
  decidedBy   Int?
  reason      String?
  decidedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [decidedBy], references: [id])
  dispatchPlanApproval DispatchPlanApproval
}

model Attachment {
  id          BigInt      @id @default(autoincrement()
  ownerType   String
  ownerId     BigInt
  uploadedBy  Int
  kind        String      @default("document")
  disk        String      @default("local")
  path        String
  mimeType    String
  sizeBytes   BigInt
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [uploadedBy], references: [id])
}

model AuditEvent {
  id          BigInt      @id @default(autoincrement()
  actorId     BigInt?
  subjectType String?
  subjectId   BigInt?
  action      String
  before      Json?
  after       Json?
  reason      String?
  requestId   String?
  ipAddress   String?
  occurredAt  DateTime
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [actorId], references: [id])
  dispatchAuditLineage DispatchAuditLineage
  dispatchOutboxMessage DispatchOutboxMessage
}

model Cache {
  key         String      @id
  value       String
  expiration  Int
}

model CacheLock {
  key         String      @id
  owner       String
  expiration  Int
}

model Client {
  id          BigInt      @id @default(autoincrement()
  code        String
  companyName String
  phone       String?
  email       String?
  address     String?
  status      String      @default("active")
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  rentalReservations RentalReservation[]
  salesOrders SalesOrder[]
  salesQuotes SalesQuote[]
  serviceRequests ServiceRequest[]
}

model CommandLog {
  id          BigInt      @id @default(autoincrement()
  userId      BigInt
  commandId   String
  actionName  String
  status      String      @default("completed")
  createdAt   DateTime?
  updatedAt   DateTime?
  payloadHash String?
  user User @relation(fields: [userId], references: [id])
  dispatchIdempotencyKey DispatchIdempotencyKey
}

model DispatchAssetAssignment {
  id          BigInt      @id @default(autoincrement()
  assignedBy  Int
  approvedBy  Int?
  activeFrom  DateTime?
  activeUntil DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  user User @relation(fields: [approvedBy], references: [id])
  operationalAsset OperationalAsset @relation(fields: [operationalAssetId], references: [id])
  dispatchJob DispatchJob @relation(fields: [dispatchJobId], references: [id])
}

model DispatchAssignmentOffer {
  id          BigInt      @id @default(autoincrement()
  attemptId   BigInt
  userId      BigInt
  isMandatory Boolean     @default(false)
  status      String      @default("proposed")
  offeredAt   DateTime?
  respondedAt DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  withdrawnAt DateTime?
  expiredAt   DateTime?
  createdBy   Int?
  approvedBy  Int?
  createdAt   DateTime?
  updatedAt   DateTime?
  endedAt     DateTime?
  endedBy     Int?
  endedReason String?
  user User @relation(fields: [endedBy], references: [id])
  dispatchExecutionAttempt DispatchExecutionAttempt @relation(fields: [attemptId], references: [id])
  dispatchPlanVersion DispatchPlanVersion @relation(fields: [planVersionId], references: [id])
  dispatchPersonnelAssignment DispatchPersonnelAssignment @relation(fields: [legacyAssignmentId], references: [id])
  dispatchAuditLineages DispatchAuditLineage[]
}

model DispatchAuditLineage {
  id          BigInt      @id @default(autoincrement()
  handoffId   BigInt?
  attemptId   BigInt?
  offerId     BigInt?
  lineageType String
  createdAt   DateTime    @default(now()
  dispatchEmergencyOverride DispatchEmergencyOverride @relation(fields: [emergencyOverrideId], references: [id])
  dispatchHandoff DispatchHandoff @relation(fields: [handoffId], references: [id])
  dispatchExecutionAttempt DispatchExecutionAttempt @relation(fields: [attemptId], references: [id])
  dispatchPlanVersion DispatchPlanVersion @relation(fields: [planVersionId], references: [id])
  dispatchIdempotencyKey DispatchIdempotencyKey @relation(fields: [idempotencyKeyId], references: [id])
}

model DispatchEmergencyOverride {
  id          BigInt      @id @default(autoincrement()
  attemptId   BigInt
  kind        String      @default("readiness_exception")
  scope       Json
  status      String      @default("proposed")
  requestedBy Int
  decidedBy   Int?
  expiresAt   DateTime
  decidedAt   DateTime?
  consumedAt  DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchAuditLineages DispatchAuditLineage[]
  dispatchIdempotencyKey DispatchIdempotencyKey @relation(fields: [idempotencyKeyId], references: [id])
  user User @relation(fields: [decidedBy], references: [id])
  dispatchPlanVersion DispatchPlanVersion @relation(fields: [planVersionId], references: [id])
  dispatchExecutionAttempt DispatchExecutionAttempt @relation(fields: [attemptId], references: [id])
}

model DispatchExecutionAttempt {
  id          BigInt      @id @default(autoincrement()
  handoffId   BigInt
  status      String      @default("draft")
  version     Int         @default("1")
  createdBy   Int?
  activatedBy Int?
  cancelledBy Int?
  archivedAt  DateTime?
  archivedBy  Int?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchAssignmentOffer DispatchAssignmentOffer
  dispatchAuditLineages DispatchAuditLineage[]
  dispatchEmergencyOverrides DispatchEmergencyOverride[]
  user User @relation(fields: [leadDesignatedBy], references: [id])
  dispatchHandoff DispatchHandoff @relation(fields: [handoffId], references: [id])
  dispatchExecutionAttempt DispatchExecutionAttempt @relation(fields: [replacesAttemptId], references: [id])
  dispatchJob DispatchJob @relation(fields: [legacyDispatchJobId], references: [id])
  dispatchIdempotencyKeys DispatchIdempotencyKey[]
  dispatchOutboxMessages DispatchOutboxMessage[]
  dispatchPlanRequirementSlots DispatchPlanRequirementSlot[]
  dispatchPlanVersions DispatchPlanVersion[]
}

model DispatchHandoff {
  id          BigInt      @id @default(autoincrement()
  sourceType  String
  sourceId    BigInt
  createdBy   Int?
  createdAt   DateTime?
  updatedAt   DateTime?
  payloadHash String?
  receivedAt  DateTime?
  snapshotAt  DateTime?
  dispatchAuditLineages DispatchAuditLineage[]
  dispatchExecutionAttempts DispatchExecutionAttempt[]
  dispatchIdempotencyKey DispatchIdempotencyKey @relation(fields: [inboundIdempotencyKeyId], references: [id])
  dispatchJob DispatchJob @relation(fields: [legacyDispatchJobId], references: [id])
  user User @relation(fields: [createdBy], references: [id])
}

model DispatchIdempotencyKey {
  id          BigInt      @id @default(autoincrement()
  ownerType   String
  ownerId     BigInt
  actionName  String
  payloadHash String?
  status      String      @default("claimed")
  attemptId   BigInt?
  claimedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  dispatchAuditLineages DispatchAuditLineage[]
  dispatchEmergencyOverride DispatchEmergencyOverride
  dispatchHandoffs DispatchHandoff[]
  dispatchOutboxMessages DispatchOutboxMessage[]
}

model DispatchJob {
  id          BigInt      @id @default(autoincrement()
  reference   String
  client      String
  title       String
  site        String
  siteNotes   String?
  priority    String
  status      String
  createdBy   Int
  activatedBy Int?
  cancelledBy Int?
  version     Int         @default("1")
  deletedAt   DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  sourceType  String?
  sourceId    BigInt?
  dispatchAssetAssignments DispatchAssetAssignment[]
  dispatchExecutionAttempt DispatchExecutionAttempt
  dispatchHandoff DispatchHandoff
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  user User @relation(fields: [createdBy], references: [id])
  dispatchPersonnelAssignments DispatchPersonnelAssignment[]
  fuelRequests FuelRequest[]
  jobReports JobReport[]
  locationUpdates LocationUpdate[]
  notifications Notification[]
  rentalReservations RentalReservation[]
  salesOrders SalesOrder[]
}

model DispatchOutboxMessage {
  id          BigInt      @id @default(autoincrement()
  dedupeKey   String
  topic       String
  aggregateId BigInt
  attemptId   BigInt?
  payload     Json
  status      String      @default("pending")
  attempts    Int         @default("0")
  availableAt DateTime?
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime?
  updatedAt   DateTime?
}

model DispatchPersonnelAssignment {
  id          BigInt      @id @default(autoincrement()
  userId      BigInt
  assignedBy  Int
  approvedBy  Int?
  activeFrom  DateTime?
  activeUntil DateTime?
  createdAt   DateTime?
  updatedAt   DateTime?
  respondedAt DateTime?
