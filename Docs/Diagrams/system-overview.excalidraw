      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 1,
      "text": "DISPATCH\nassign people + equipment\nreject unsafe or double-booked assets\nmanager approval for priority work\nversion checks prevent stale updates\n\nFUEL\nsubmitted → forwarded → approved → verified\nseparation of duties blocks self-approval\n\nFIELD & SAFETY\nGPS • sync state • inspections • maintenance blocks\n\nGPT\nexplainable recommendation — human confirms writes",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DISPATCH\nassign people + equipment\nreject unsafe or double-booked assets\nmanager approval for priority work\nversion checks prevent stale updates\n\nFUEL\nsubmitted → forwarded → approved → verified\nseparation of duties blocks self-approval\n\nFIELD & SAFETY\nGPS updates • inspections • maintenance blocks\n\nGPT\nrecommendation only — a human confirms writes",
      "lineHeight": 1.32,
      "baseline": 329,
      "index": "aQ",
      "autoResize": true
    },
