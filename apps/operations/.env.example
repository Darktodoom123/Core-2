APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production URL (HostForge Platform):
# APP_URL=https://core-2.alibaton-ph.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_SSLMODE=disable

# Docker Compose local PostgreSQL example. Set these values in your untracked
# .env before running Docker; do not copy real credentials into this file or an
# image. The Compose file overrides REDIS_HOST to the local redis service.
# APP_KEY=base64:<generate-a-32-byte-key>
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=core2
# DB_USERNAME=core2
# DB_PASSWORD=<local-only-password>
# Operations calls Tracking over the internal Compose network. Keep this
# secret identical in both services and generate it locally.
TRACKING_SERVICE_DRIVER=http
TRACKING_SERVICE_URL=http://tracking
TRACKING_SERVICE_SECRET=<local-only-shared-secret>
# Tracking has its own application key, database role, and persistent volumes.
TRACKING_APP_KEY=base64:<generate-a-second-32-byte-key>
TRACKING_DB_DATABASE=core2_ms_tracking
TRACKING_DB_USERNAME=tracking
TRACKING_DB_PASSWORD=<tracking-local-only-password>
# RUN_MIGRATIONS=true
# CACHE_CONFIG=true

# Supabase / PostgreSQL Supavisor Connection Pooling (Production / Staging)
# Pooler Transaction Mode (Port 6543) for Web & Queue Workers:
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_EMULATE_PREPARES=true
#
# Optional Direct / Migration Connection (Port 5432) for DDL / Migrations:
# DB_DIRECT_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_DIRECT_PORT=5432
# DB_DIRECT_DATABASE=postgres
# DB_DIRECT_USERNAME=postgres
# DB_DIRECT_PASSWORD=
# DB_DIRECT_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Temporary compatibility for older mobile APKs; set to a past date to disable.
AUTH_LEGACY_EMAIL_LOGIN_UNTIL=2026-11-07

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_INPUT_TOKENS=32000
OPENAI_MAX_COST_USD=0.05
OPENAI_PROACTIVE_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 Object Storage (Dual-Tier: Public Media & Protected Documents)
# Shared Infrastructure
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true

# Public Media Tier (DVIR walkaround photos, avatar thumbnails, equipment assets)
# URL format: https://<PUBLIC_BUCKET_HASH>.r2.dev or custom domain https://media.yourdomain.com
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_URL=
R2_PUBLIC_URL=
DVIR_PHOTO_DISK=public

# Protected Documents Tier (Signed job completion forms, DVIR compliance sheets, export PDFs)
R2_PRIVATE_BUCKET=
R2_PRIVATE_USE_PATH_STYLE_ENDPOINT=true
PROTECTED_DOCUMENTS_DISK=r2-private
# ATTACHMENTS_DISK=r2-private

REVERB_APP_ID=core2-local
REVERB_APP_KEY=replace-with-public-reverb-key
REVERB_APP_SECRET=replace-with-private-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_FORWARD_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# Production Reverb (HostForge Platform on core-2.alibaton-ph.com):
# VITE_REVERB_HOST=core-2.alibaton-ph.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https

# Field Emergency SOS remains disabled until responder/provider/device gates pass.
SOS_ENABLED=false
SOS_ACK_DEADLINE_SECONDS=180
SOS_MOBILE_FRESHNESS_SECONDS=900
SOS_QUEUE=emergency
SOS_ESCALATION_DRIVER=null
SOS_LOCAL_EMERGENCY_LABEL=
SOS_LOCAL_EMERGENCY_NUMBER=
SOS_COORDINATE_RETENTION_DAYS=30

# Browser map configuration. Set VITE_MAP_USE_CASE=academic only for a
# non-commercial capstone/demo deployment. Use a paid plan for commercial use.
# Leave the style URL empty to use the built-in Stadia Alidade Smooth style.
VITE_MAP_PROVIDER=stadia
VITE_MAP_PLAN=free
VITE_MAP_USE_CASE=commercial
VITE_MAP_STYLE_URL=
VITE_MAP_ATTRIBUTION=
# This is a public browser/mobile credential. Restrict it by domain/referrer in Stadia.
VITE_STADIA_MAPS_API_KEY=
EXPO_PUBLIC_STADIA_MAPS_API_KEY=
# For a paid production deployment, use: VITE_MAP_PLAN=starter

# Tomorrow.io Weather & Masthead Wind Telemetry API
TOMORROW_IO_API_KEY=
