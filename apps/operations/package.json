{
    "name": "@core-2/operations",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build --config vite.config.ts",
        "build:ssr": "vite build --config vite.config.ts && vite build --config vite.config.ts --ssr",
        "dev": "vite --config vite.config.ts",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit -p ../../tsconfig.json",
        "test:unit": "vitest run --config ../../vitest.config.ts",
        "test:e2e": "playwright test --config ../../playwright.config.ts",
        "test:e2e:maplibre": "playwright test --config ../../playwright.config.ts tests/Browser/maplibre-tracking.spec.ts",
        "test:a11y": "playwright test --config ../../playwright.config.ts tests/Browser/accessibility.spec.ts"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.7.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "image-size": "file:../../third_party/image-size",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.24.0",
        "maplibre-gl": "^6.4.1",
        "motion": "^12.43.0",
        "pusher-js": "^8.6.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "fontaine": "^0.8.0",
        "jsdom": "^29.1.1",
        "vitest": "^4.1.11"
    }
}
