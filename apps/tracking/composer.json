{
    "name": "core2/tracking",
    "type": "project",
    "description": "Tracking & Telemetry Microservice for Core-2",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Tracking\\": "app/",
            "Tracking\\Database\\Factories\\": "database/factories/",
            "Tracking\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tracking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "types:check": "phpstan analyse --memory-limit=512M",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
