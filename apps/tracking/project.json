{
    "name": "tracking",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/tracking/app",
    "targets": {
        "lint": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/pint --test",
                "cwd": "apps/tracking"
            }
        },
        "types": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=512M",
                "cwd": "apps/tracking"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/pest -c phpunit.xml",
                "cwd": "apps/tracking",
                "env": {
                    "DB_CONNECTION": "sqlite",
                    "DB_DATABASE": ":memory:"
                }
            }
        },
        "php-lint": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/pint --test",
                "cwd": "apps/tracking"
            }
        },
        "php-types": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=512M",
                "cwd": "apps/tracking"
            }
        },
        "php-test": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "php vendor/bin/pest -c phpunit.xml",
                "cwd": "apps/tracking",
                "env": {
                    "DB_CONNECTION": "sqlite",
                    "DB_DATABASE": ":memory:"
                }
            }
        }
    }
}
