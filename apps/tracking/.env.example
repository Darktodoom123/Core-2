APP_NAME=TrackingService
APP_ENV=local
# Generate with: php apps/tracking/artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

DB_CONNECTION=pgsql
DB_HOST=tracking-db
DB_PORT=5432
DB_DATABASE=core2_ms_tracking
DB_USERNAME=tracking
DB_PASSWORD=<tracking-local-only-password>
DB_SSLMODE=prefer

# For Supabase, use this project's Connect dialog values instead of tracking-db.
# Direct: DB_HOST=db.<project-ref>.supabase.co, DB_USERNAME=postgres
# IPv4: use the Session pooler host, DB_USERNAME=postgres.<project-ref>
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_SSLMODE=require

# Operations is the only service allowed to call the internal API.
TRACKING_SERVICE_SECRET=<local-only-shared-secret>
TRACKING_ALLOWED_SERVICES=operations

# The retention scheduler uses persistent file locks in tracking-storage-data.
CACHE_STORE=file
CACHE_PREFIX=core2_tracking_cache_
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
RUN_MIGRATIONS=true
CACHE_CONFIG=true
DB_WAIT_TIMEOUT_SECONDS=60
DB_WAIT_INTERVAL_SECONDS=2
DB_WAIT_PROBE_TIMEOUT_SECONDS=5
MIGRATION_TIMEOUT_SECONDS=120
