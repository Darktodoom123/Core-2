{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "operations-web",
      "runtimeExecutable": "php",
      "runtimeArgs": ["apps/operations/artisan", "serve", "--host=0.0.0.0", "--port=8000"],
      "port": 8000
    },
    {
      "name": "operations-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "operations-reverb",
      "runtimeExecutable": "php",
      "runtimeArgs": ["apps/operations/artisan", "reverb:start"],
      "port": 8080
    },
    {
      "name": "operations-queue",
      "runtimeExecutable": "php",
      "runtimeArgs": ["apps/operations/artisan", "queue:work", "--queue=high,default,emergency", "--tries=3"],
      "port": 8099
    },
    {
      "name": "tracking-api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["apps/tracking/artisan", "serve", "--host=127.0.0.1", "--port=8001"],
      "port": 8001
    },
    {
      "name": "operations-browser-fixtures",
      "runtimeExecutable": "php",
      "runtimeArgs": ["apps/operations/tests/Browser/web-server.php"],
      "port": 4173
    }
  ]
}
