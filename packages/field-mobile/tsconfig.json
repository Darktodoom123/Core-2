{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "types": ["jest", "node", "react"]
    },
    "include": ["App.tsx", "src/**/*", "jest.setup.ts"],
    "extends": "expo/tsconfig.base"
}
