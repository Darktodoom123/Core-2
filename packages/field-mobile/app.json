{
    "expo": {
        "name": "Alibaton",
        "slug": "core-2-field-mobile",
        "version": "1.0.0",
        "icon": "./assets/icon.png",
        "platforms": ["android"],
        "orientation": "default",
        "userInterfaceStyle": "automatic",
        "plugins": [
            [
                "expo-dev-client",
                {
                    "skipOnboarding": true,
                    "showMenuAtLaunch": false,
                    "toolsButton": false
                }
            ],
            "expo-secure-store",
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Allow Core 2 Field App to access your location to track job progress and update operational telemetry.",
                    "isAndroidBackgroundLocationEnabled": true,
                    "isAndroidForegroundServiceEnabled": true
                }
            ],
            "./plugins/with-gradle-build-memory.cjs",
            "./plugins/with-gradle-problems-report.cjs",
            "./plugins/with-detox-android.cjs",
            "expo-splash-screen"
        ],
        "android": {
            "package": "com.core2.fieldmobile",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#FAFAFA"
            },
            "permissions": [
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION",
                "ACCESS_BACKGROUND_LOCATION"
            ]
        }
    }
}
