{
  "name": "@core-2/field-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.cjs",
    "ios": "expo run:ios",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --no-bytecode",
    "export:ios": "expo export --platform ios --no-bytecode",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:detox:android": "expo prebuild --platform android --clean",
    "build:android:debug": "npm run prebuild:android && node scripts/gradle-android.cjs assembleDebug",
    "e2e:create-avd:android": "node scripts/create-android-avd.cjs",
    "e2e:build:android": "npm run prebuild:detox:android && node scripts/gradle-android.cjs assembleDebug assembleAndroidTest -DtestBuildType=debug",
    "e2e:test:android": "node scripts/detox-android.cjs",
    "types:check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "tsx --test src/__tests__/*.test.ts",
    "test:components": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "expo": "^57.0.8",
    "expo-dev-client": "57.0.9",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "57.0.1",
    "react": "^19.2.0",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "detox": "20.51.4",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.2",
    "react-test-renderer": "19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
