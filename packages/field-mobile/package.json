{
    "name": "@core-2/field-mobile",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "index.js",
    "scripts": {
        "start": "expo start",
        "android": "node scripts/run-android.cjs",
        "doctor": "expo-doctor",
        "export:android": "expo export --platform android --no-bytecode",
        "prebuild:android": "expo prebuild --platform android",
        "prebuild:detox:android": "expo prebuild --platform android --clean",
        "build:android:debug": "npm run prebuild:android && node scripts/gradle-android.cjs assembleDebug",
        "e2e:create-avd:android": "node scripts/create-android-avd.cjs",
        "e2e:build:android": "npm run prebuild:detox:android && node scripts/gradle-android.cjs assembleDebug assembleAndroidTest -DtestBuildType=debug",
        "e2e:test:android": "node scripts/detox-android.cjs",
        "types:check": "tsc --noEmit",
        "test": "npm run test:unit && npm run test:components",
        "test:unit": "tsx --test src/__tests__/*.test.ts",
        "test:components": "jest --config jest.config.cjs --runInBand"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.0.2",
        "@react-native-community/netinfo": "12.0.1",
        "expo": "~57.0.11",
        "expo-crypto": "~57.0.1",
        "expo-dev-client": "~57.0.10",
        "expo-image-picker": "~57.0.13",
        "expo-location": "~57.0.8",
        "expo-secure-store": "^57.0.1",
        "expo-splash-screen": "~57.0.5",
        "expo-sqlite": "~57.0.1",
        "expo-system-ui": "~57.0.2",
        "expo-task-manager": "~57.0.1",
        "react": "19.2.3",
        "react-native": "0.86.2",
        "react-native-safe-area-context": "5.7.0",
        "react-native-webview": "^14.0.1"
    },
    "devDependencies": {
        "@testing-library/react-native": "14.0.1",
        "@types/jest": "29.5.14",
        "@types/node": "^22.13.5",
        "@types/react": "^19.2.0",
        "detox": "20.51.4",
        "expo-doctor": "1.20.1",
        "jest": "29.7.0",
        "jest-expo": "~57.0.3",
        "react-test-renderer": "19.2.3",
        "tsx": "^4.19.2",
        "typescript": "~6.0.3"
    },
    "expo": {
        "install": {
            "exclude": [
                "react-native-webview",
                "expo",
                "expo-crypto",
                "expo-dev-client",
                "expo-image-picker",
                "expo-location",
                "expo-secure-store",
                "expo-splash-screen",
                "expo-sqlite",
                "expo-system-ui",
                "expo-task-manager",
                "react-native",
                "jest-expo"
            ]
        }
    }
}
