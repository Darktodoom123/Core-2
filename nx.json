{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "parallel": 1,
    "neverConnectToCloud": true,
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/package-lock.json"
        ]
    },
    "targetDefaults": {
        "nx:run-commands": {
            "cache": false
        }
    }
}
