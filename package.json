{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ packages/field-mobile/",
        "format:check": "prettier --check resources/ packages/field-mobile/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:maplibre": "playwright test tests/Browser/maplibre-tracking.spec.ts",
        "test:a11y": "playwright test tests/Browser/accessibility.spec.ts",
        "types:check:mobile": "npm --prefix packages/field-mobile run types:check",
        "test:mobile": "npm --prefix packages/field-mobile run test",
        "verify:frontend-build": "node scripts/verify-frontend-build.cjs",
        "mobile:doctor": "npm --prefix packages/field-mobile run doctor",
        "mobile:start": "npm --prefix packages/field-mobile run start -- --dev-client",
        "mobile:api": "php artisan serve --host=0.0.0.0 --port=8000",
        "mobile:android": "npm --prefix packages/field-mobile run android",
        "mobile:export:android": "npm --prefix packages/field-mobile run export:android",
        "mobile:build:android:debug": "npm --prefix packages/field-mobile run build:android:debug",
        "mobile:e2e:create-avd:android": "npm --prefix packages/field-mobile run e2e:create-avd:android",
        "mobile:e2e:build:android": "npm --prefix packages/field-mobile run e2e:build:android",
        "mobile:e2e:test:android": "npm --prefix packages/field-mobile run e2e:test:android",
        "mobile:session1:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1",
        "mobile:session1:native:api30": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -AndroidAvd core2_api_30_phone",
        "mobile:session1:native:api36": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -AndroidAvd core2_api_36",
        "mobile:sprint2:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js",
        "mobile:sprint2:native:api30": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js -AndroidAvd core2_api_30_phone",
        "mobile:sprint2:native:api36": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js -AndroidAvd core2_api_36",
        "security:image-size": "node scripts/test-image-size-hardening.cjs",
        "audit:gauntlet": "node scripts/gauntlet-audit.cjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "fontaine": "^0.8.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "react-native": "0.86.2",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "image-size": "file:third_party/image-size",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.24.0",
        "maplibre-gl": "^6.3.0",
        "motion": "^12.43.0",
        "pusher-js": "^8.6.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "metro": {
            "image-size": "$image-size"
        },
        "nanoid": "3.3.18",
        "xcode@3.0.1": {
            "uuid": "11.1.1"
        }
    }
}
