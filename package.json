{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "core2",
    "private": true,
    "nx": {
        "includedScripts": []
    },
    "type": "module",
    "workspaces": [
        "apps/operations",
        "packages/field-mobile"
    ],
    "scripts": {
        "build": "npm run build --workspace=@core-2/operations",
        "build:ssr": "npm run build:ssr --workspace=@core-2/operations",
        "dev": "npm run dev --workspace=@core-2/operations",
        "format": "prettier --write apps/operations/resources/ packages/field-mobile/",
        "format:check": "prettier --check apps/operations/resources/ packages/field-mobile/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:maplibre": "playwright test apps/operations/tests/Browser/maplibre-tracking.spec.ts",
        "test:a11y": "playwright test apps/operations/tests/Browser/accessibility.spec.ts",
        "test:unit": "vitest run",
        "test:integration:services": "node --import tsx scripts/test-integration-services.ts",
        "types:check:mobile": "npm run types:check --workspace=@core-2/field-mobile",
        "test:mobile": "npm run test --workspace=@core-2/field-mobile",
        "test:mobile:lifecycle": "php apps/operations/artisan test --test-directory=apps/operations/tests apps/operations/tests/Feature/MobileLifecycle/MobileLifecycleEndToEndTest.php",
        "verify:frontend-build": "node scripts/verify-frontend-build.cjs",
        "mobile:doctor": "npm run doctor --workspace=@core-2/field-mobile",
        "mobile:start": "npm run start --workspace=@core-2/field-mobile -- --dev-client",
        "mobile:api": "php apps/operations/artisan serve --host=0.0.0.0 --port=8000",
        "mobile:android": "npm run android --workspace=@core-2/field-mobile",
        "mobile:export:android": "npm run export:android --workspace=@core-2/field-mobile",
        "mobile:build:android:debug": "npm run build:android:debug --workspace=@core-2/field-mobile",
        "mobile:e2e:create-avd:android": "npm run e2e:create-avd:android --workspace=@core-2/field-mobile",
        "mobile:e2e:build:android": "npm run e2e:build:android --workspace=@core-2/field-mobile",
        "mobile:e2e:test:android": "npm run e2e:test:android --workspace=@core-2/field-mobile",
        "mobile:session1:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1",
        "mobile:session1:native:api30": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -AndroidAvd core2_api_30_phone",
        "mobile:session1:native:api36": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -AndroidAvd core2_api_36",
        "mobile:sprint2:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js",
        "mobile:sprint2:native:api30": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js -AndroidAvd core2_api_30_phone",
        "mobile:sprint2:native:api36": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packages/field-mobile/scripts/session1-native-external.ps1 -EvidenceScope sprint2 -DetoxTestPath e2e/session2-outbox.e2e.test.js -AndroidAvd core2_api_36",
        "security:image-size": "node scripts/test-image-size-hardening.cjs",
        "audit:gauntlet": "node scripts/gauntlet-audit.cjs",
        "audit:lighthouse": "node scripts/run-lighthouse.cjs",
        "audit:lighthouse:all": "node scripts/run-lighthouse.cjs --all",
        "audit:lighthouse:deep": "node scripts/run-lighthouse.cjs --deep",
        "audit:lighthouse:mobile": "node scripts/run-lighthouse.cjs --preset=mobile",
        "audit:lighthouse:desktop": "node scripts/run-lighthouse.cjs --preset=desktop",
        "audit:lighthouse:build": "npm run build && node scripts/run-lighthouse.cjs --all",
        "audit:lighthouse:ci": "lhci autorun"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "fontaine": "^0.8.0",
        "image-size": "file:third_party/image-size",
        "jsdom": "^29.1.1",
        "nx": "23.2.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "react-native": "0.86.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.23.0",
        "vitest": "^4.1.11"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "metro": {
            "image-size": "$image-size"
        },
        "nanoid": "3.3.18",
        "xcode@3.0.1": {
            "uuid": "11.1.1"
        }
    }
}
